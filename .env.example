# Postgres connection string. Use the pooled Neon URL in production. Paste it as
# Neon gives it (postgres://..., with ?sslmode=require and possibly
# &channel_binding=require): app/db.py adapts it for SQLAlchemy + asyncpg and turns
# prepared statements off for PgBouncer. The schema must already exist: this service
# never migrates; the Next.js repo's drizzle/*.sql owns it.
DATABASE_URL="postgres://postgres:dev@localhost:54329/links"

# Shared secret the Next.js BFF sends as "Authorization: Bearer <token>".
# Required, 16+ characters. Use a long random value in production.
LINK_BACKEND_TOKEN="change-me-to-a-long-random-string"

# Optional. Render sets PORT itself; the Dockerfile defaults it to 8080.
# PORT=8080
